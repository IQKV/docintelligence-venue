<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iqkv.docintelligence.venue.VenueDocumentMapper">

    <!-- Tenant-scoped: statements are unqualified by schema. The MyBatisSchemaInterceptor in each
         consuming service sets search_path to t_{tenantKey}, public before every statement, so
         'venue_documents' resolves to the active tenant schema. -->

    <resultMap id="venueDocumentResultMap"
               type="com.iqkv.docintelligence.venue.VenueDocument">
        <id property="id" column="id"/>
        <result property="fileName" column="file_name"/>
        <result property="contentType" column="content_type"/>
        <result property="sizeBytes" column="size_bytes"/>
        <result property="objectKey" column="object_key"/>
        <result property="status" column="status"/>
        <result property="uploadedBy" column="uploaded_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.iqkv.docintelligence.venue.VenueDocument">
        INSERT INTO venue_documents
        (id, file_name, content_type, size_bytes, object_key, status, uploaded_by)
        VALUES
        (#{id}, #{fileName}, #{contentType}, #{sizeBytes}, #{objectKey}, #{status}, #{uploadedBy})
    </insert>

    <select id="findById" resultMap="venueDocumentResultMap">
        SELECT id, file_name, content_type, size_bytes, object_key, status, uploaded_by,
               created_at, updated_at
        FROM venue_documents
        WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="venueDocumentResultMap">
        SELECT id, file_name, content_type, size_bytes, object_key, status, uploaded_by,
               created_at, updated_at
        FROM venue_documents
        ORDER BY created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM venue_documents
    </select>

    <update id="updateStatus">
        UPDATE venue_documents
        SET status = #{status}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM venue_documents WHERE id = #{id}
    </delete>

</mapper>
